# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
# Same value goes into the app under Daten → NAS-Server → Token. Generate e.g. with: openssl rand -hex 24
GAPMIN_TOKEN=change-me
GAPMIN_PORT=8085
# Where database files live on the NAS (default: ./data next to this file)
# GAPMIN_DATA_DIR=/srv/dev-disk-by-uuid-XXXX/gapmin
